{
  "name": "cms-microfrontend-demo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:shell\" \"pnpm run dev:members\" \"pnpm run dev:events\" \"pnpm run dev:admin\"",

    "dev:shell": "pnpm --filter shell dev",
    "dev:members": "pnpm --filter members-app dev",
    "dev:events": "pnpm --filter events-app dev",
    "dev:admin": "pnpm --filter admin-app dev",

    "build": "pnpm -r build",

    "preview:shell": "pnpm --filter shell preview",
    "preview:members": "pnpm --filter members-app preview",
    "preview:events": "pnpm --filter events-app preview",
    "preview:admin": "pnpm --filter admin-app preview"

    
  },

  
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}